// ALERT-LoRa: Individual Test - LEDs
#include <Arduino.h>
#include "config.h"   // Use your config.h with LED pins
#include "led_control.h" // Use your led_control.h for LED functions

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("ALERT-LoRa LED Test Starting...");

  initLEDs();

  // Startup sequence
  setGreenLED(true); delay(500); setGreenLED(false);
  setBlueLED(true);  delay(500); setBlueLED(false);
  setRedLED(true);   delay(500); setRedLED(false);

  Serial.println("LEDs initialized ✅");
}

void loop() {
  Serial.println("--- LED Cycle ---");
  
  // Green ON (Power)
  setGreenLED(true);
  Serial.println("GREEN ON (Power indicator)");
  delay(1000);
  setGreenLED(false);

  // Blue blink (TX simulation)
  for(int i=0; i<3; i++) {
    setBlueLED(true); delay(150);
    setBlueLED(false);  delay(150);
  }
  Serial.println("BLUE blinked (TX indicator)");

  // Red blink (Error simulation)
  for(int i=0; i<3; i++) {
    setRedLED(true); delay(200);
    setRedLED(false);  delay(200);
  }
  Serial.println("RED blinked (Error indicator)");

  delay(2000);
}